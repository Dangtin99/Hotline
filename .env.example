# Environment variables template for Hotline Logistics Cancellation Analytics
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here

# Supabase PostgreSQL Configuration
SUPABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres.your_project_id
SUPABASE_PASSWORD=your_supabase_password

# Turso (Optional SQLite Edge)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# eDepot Automated Ingestion Credentials (DO NOT COMMIT REAL VALUES)
EDEPOT_USERNAME=
EDEPOT_PASSWORD=

# Vercel Cron Security Secret
CRON_SECRET=
